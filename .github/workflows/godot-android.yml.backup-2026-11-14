name: Новая Жизнь — Android Debug APK

"on":
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-android:
    name: Import, smoke test and export APK
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    container:
      image: barichello/godot-ci:4.3

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          lfs: true

      - name: Verify the correct Godot project archive
        shell: bash
        run: |
          set -euo pipefail
          ARCHIVE=""
          for candidate in \
            "NewLife_V0_3_3_Safe_Save.zip" \
            "NewLife_V0_3_1_CloudBuild.zip" \
            "NewLife_V0_4_CloudBuild_Kit.zip"; do
            if [ -s "$GITHUB_WORKSPACE/$candidate" ]; then
              ARCHIVE="$GITHUB_WORKSPACE/$candidate"
              break
            fi
          done

          if [ -z "$ARCHIVE" ]; then
            if [ -s "$GITHUB_WORKSPACE/NovayaZhizn_GitHub_AutoBuild_v1.2.zip" ]; then
              echo "::error title=Неверный архив::Найден NovayaZhizn_GitHub_AutoBuild_v1.2.zip — это старый Android/Gradle-проект, а не Godot-проект. Загрузите NewLife_V0_3_3_Safe_Save.zip из чата."
              unzip -Z1 "$GITHUB_WORKSPACE/NovayaZhizn_GitHub_AutoBuild_v1.2.zip" | sed -n '1,18p'
            else
              echo "::error title=Нет исходников Godot::В корне ветки нужен NewLife_V0_3_3_Safe_Save.zip, NewLife_V0_3_1_CloudBuild.zip или NewLife_V0_4_CloudBuild_Kit.zip."
            fi
            exit 1
          fi

          if ! unzip -Z1 "$ARCHIVE" | grep -Eq '(^|/)project\.godot$'; then
            echo "::error::В выбранном ZIP нет project.godot. Это не архив Godot-проекта."
            exit 1
          fi
          if ! unzip -Z1 "$ARCHIVE" | grep -Eq '(^|/)export_presets\.cfg$'; then
            echo "::error::В архиве отсутствует export_presets.cfg."
            exit 1
          fi

          rm -rf "$GITHUB_WORKSPACE/extracted"
          mkdir -p "$GITHUB_WORKSPACE/extracted"
          unzip -q "$ARCHIVE" -d "$GITHUB_WORKSPACE/extracted"
          PROJECT_FILE="$(find "$GITHUB_WORKSPACE/extracted" -type f -name project.godot -print -quit)"
          test -n "$PROJECT_FILE" || { echo "::error::Не удалось найти project.godot после распаковки"; exit 1; }
          PROJECT_DIR="$(dirname "$PROJECT_FILE")"

          for required in \
            "scripts/main.gd" \
            "scenes/Main.tscn" \
            "assets/city_map.png" \
            "assets/apartment.png"; do
            test -s "$PROJECT_DIR/$required" || { echo "::error::В проекте отсутствует $required"; exit 1; }
          done
          grep -q 'name="Android Debug"' "$PROJECT_DIR/export_presets.cfg" || { echo "::error::Не найден preset Android Debug"; exit 1; }

          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo "Используется архив: $ARCHIVE"
          echo "Godot-проект найден: $PROJECT_DIR"

      - name: Prepare Godot 4.3 Android environment
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$HOME/.config" "$HOME/.local/share/godot/export_templates"
          if [ "$HOME" != "/root" ]; then
            if [ -d /root/.config/godot ]; then
              mkdir -p "$HOME/.config/godot"
              cp -a /root/.config/godot/. "$HOME/.config/godot/"
            fi
            if [ -d /root/.local/share/godot/export_templates/4.3.stable ]; then
              mkdir -p "$HOME/.local/share/godot/export_templates/4.3.stable"
              cp -a /root/.local/share/godot/export_templates/4.3.stable/. "$HOME/.local/share/godot/export_templates/4.3.stable/"
            fi
          fi

          GODOT_VERSION="$(godot --version)"
          echo "Godot: $GODOT_VERSION"
          case "$GODOT_VERSION" in
            4.3*) ;;
            *) echo "::error::Ожидался Godot 4.3, получен $GODOT_VERSION"; exit 1 ;;
          esac

          java -version
          test -f /root/debug.keystore || { echo "::error::В контейнере отсутствует debug.keystore"; exit 1; }
          export ANDROID_SDK_ROOT="$ANDROID_HOME"
          yes | sdkmanager --sdk_root="$ANDROID_HOME" --licenses >/dev/null 2>&1 || true
          sdkmanager --sdk_root="$ANDROID_HOME" \
            "platform-tools" \
            "build-tools;34.0.0" \
            "platforms;android-34" \
            "cmake;3.10.2.4988404" \
            "ndk;23.2.8568313"

      - name: Import resources and validate scripts
        shell: bash
        run: |
          set -euo pipefail
          LOG="$GITHUB_WORKSPACE/godot-import.log"
          godot --headless --path "$PROJECT_DIR" --editor --quit --verbose 2>&1 | tee "$LOG"
          if grep -Eq 'SCRIPT ERROR:|Parse Error:|Failed to load script' "$LOG"; then
            echo "::error::Godot сообщил об ошибке GDScript или загрузки скрипта."
            exit 1
          fi

      - name: Run a short headless startup test
        shell: bash
        run: |
          set -euo pipefail
          LOG="$GITHUB_WORKSPACE/godot-smoke-test.log"
          godot --headless --path "$PROJECT_DIR" --quit-after 3 --verbose 2>&1 | tee "$LOG"
          if grep -Eq 'SCRIPT ERROR:|Parse Error:|Failed to load script' "$LOG"; then
            echo "::error::Главная сцена выдала ошибку при запуске."
            exit 1
          fi

      - name: Export Android Debug APK
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$GITHUB_WORKSPACE/build/android"
          GODOT_ANDROID_KEYSTORE_DEBUG_PATH=/root/debug.keystore \
          GODOT_ANDROID_KEYSTORE_DEBUG_USER=androiddebugkey \
          GODOT_ANDROID_KEYSTORE_DEBUG_PASSWORD=android \
            godot --headless --path "$PROJECT_DIR" --export-debug "Android Debug" "$GITHUB_WORKSPACE/build/android/NewLife-V0.3.3-debug.apk"
          test -s "$GITHUB_WORKSPACE/build/android/NewLife-V0.3.2-debug.apk"
          unzip -t "$GITHUB_WORKSPACE/build/android/NewLife-V0.3.2-debug.apk" >/dev/null
          ls -lh "$GITHUB_WORKSPACE/build/android/NewLife-V0.3.2-debug.apk"

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: NewLife-Android-Debug-APK-V0.3.3
          path: build/android/NewLife-V0.3.2-debug.apk
          if-no-files-found: error
          retention-days: 14
